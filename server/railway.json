{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NPM",
    "buildCommand": "npm install --legacy-peer-deps && npm run build"
  },
  "deploy": {
    "startCommand": "node dist/standalone.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
} 